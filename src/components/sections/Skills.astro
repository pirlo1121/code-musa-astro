---
import { skills } from '../../data/skills';
---

<section id="skills" class="station station--grid" aria-labelledby="skills-title">
  <div class="station__inner">
    <header class="section-head" data-reveal>
      <p class="kicker" data-reveal-item>03 — Nebulosa esmeralda</p>
      <h2 id="skills-title" class="section-title" data-reveal-item data-focus-target>Habilidades</h2>
    </header>

    <ul class="skill-list" role="list" data-reveal>
      {skills.map((skill) => (
        <li class="skill glass" style={`--dot: ${skill.color}`} data-reveal-item>
          <span class="skill__dot" aria-hidden="true"></span>
          {skill.name}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .skill-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    max-width: 52rem;
  }

  .skill {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
    border-color: color-mix(in srgb, var(--dot) 35%, transparent);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4), 0 0 28px color-mix(in srgb, var(--dot) 18%, transparent);
  }

  .skill__dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--dot);
    box-shadow: 0 0 14px var(--dot);
  }
</style>
