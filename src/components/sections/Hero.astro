---
import type { Profile } from '../../lib/data';
import { site } from '../../data/site';

interface Props { profile: Profile | null }
const { profile } = Astro.props;
const name = profile?.name ?? site.fallbackName;
const role = profile?.profession ?? site.fallbackRole;
---

<section id="hero" class="station station--hero" aria-labelledby="hero-title">
  <div class="hero__stage">
    <div class="station__inner">
      <div class="hero__content" data-hero-content>
        <p class="eyebrow" data-intro>
          <span class="eyebrow__dot" aria-hidden="true"></span>
          {role}
        </p>
        <h1 id="hero-title" class="hero__title" data-intro data-focus-target>{name}</h1>
        <p class="hero__tagline" data-intro>{site.tagline}</p>
        <div class="hero__actions" data-intro>
          <a class="btn btn--primary" href="#projects">
            Explorar proyectos
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a class="btn btn--ghost" href="#contact">Contactar</a>
        </div>
      </div>
    </div>
    <div class="launch" data-intro>
      <button type="button" class="launch__button" data-autopilot-start>
        <span class="launch__ring" aria-hidden="true"></span>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg>
        Iniciar viaje
      </button>
      <a class="launch__manual" href="#about">
        <span class="launch__line" aria-hidden="true"></span>
        o desplázate a tu ritmo
      </a>
    </div>
  </div>
</section>

<style>
  .station--hero {
    padding-block: 0;
    min-height: 170svh;
    align-items: flex-start;
  }

  .hero__stage {
    position: relative;
    width: 100%;
    min-height: 100svh;
    display: flex;
    align-items: center;
  }

  .hero__content { max-width: 40rem; }

  .hero__title {
    font-size: clamp(2.8rem, 7.5vw, 6.2rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    font-weight: 700;
    margin: 1.1rem 0 1.4rem;
    background: linear-gradient(180deg, #ffffff 30%, #b8c6ee);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-wrap: balance;
  }

  .hero__tagline {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 32rem;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.2rem;
  }

  .launch {
    position: absolute;
    left: 50%;
    bottom: calc(2.2rem + env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .launch__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 1.9rem 1rem 1.6rem;
    border: 1px solid rgba(255, 220, 180, 0.45);
    border-radius: 999px;
    background:
      radial-gradient(120% 140% at 50% 0%, rgba(255, 190, 120, 0.28), rgba(255, 140, 60, 0.06) 60%),
      rgba(6, 9, 22, 0.55);
    color: #fff;
    font: inherit;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    box-shadow: 0 0 40px rgba(255, 150, 70, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s ease, border-color 0.3s ease;
  }

  .launch__button:hover {
    transform: translateY(-2px) scale(1.03);
    border-color: rgba(255, 220, 180, 0.8);
    box-shadow: 0 0 60px rgba(255, 150, 70, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  /* Slow sonar ping around the button. */
  .launch__ring {
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    border: 1px solid rgba(255, 200, 150, 0.6);
    animation: ping 2.8s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    pointer-events: none;
  }

  @keyframes ping {
    0% { transform: scale(1); opacity: 0.8; }
    100% { transform: scale(1.35, 1.7); opacity: 0; }
  }

  .launch__manual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
    text-decoration: none;
  }

  .launch__manual:hover { color: var(--ink-2); }

  .launch__line {
    order: 1;
    width: 1px;
    height: 30px;
    background: linear-gradient(to bottom, transparent, var(--ink-2));
    animation: cue 2.4s ease-in-out infinite;
    transform-origin: top;
  }

  @keyframes cue {
    0% { transform: scaleY(0); opacity: 0; }
    40% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1) translateY(14px); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .launch__line,
    .launch__ring { animation: none; }
  }

  @media (max-width: 900px) {
    /* The star sits in the upper half on phones; copy anchors to the bottom. */
    .hero__stage { align-items: flex-end; padding-bottom: 10.5rem; }
  }
</style>
