---
import type { Profile } from '../../lib/data';
import { site } from '../../data/site';

interface Props { profile: Profile | null }
const { profile } = Astro.props;
const name = profile?.name ?? site.fallbackName;
const role = profile?.profession ?? site.fallbackRole;
---

<section id="hero" class="station station--hero" aria-labelledby="hero-title">
  <div class="hero__stage">
    <div class="station__inner">
      <div class="hero__content" data-hero-content>
        <p class="eyebrow" data-intro>
          <span class="eyebrow__dot" aria-hidden="true"></span>
          {role}
        </p>
        <h1 id="hero-title" class="hero__title" data-intro data-focus-target>{name}</h1>
        <p class="hero__tagline" data-intro>{site.tagline}</p>
        <div class="hero__actions" data-intro>
          <button type="button" class="launch" data-autopilot-start>
            <span class="launch__icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg>
            </span>
            <span class="launch__text">
              <span class="launch__label">Iniciar viaje</span>
              <span class="launch__hint">Recorrido guiado · 1 min</span>
            </span>
          </button>
          <div class="hero__links">
            <a class="btn btn--ghost" href="#projects">Ver proyectos</a>
            <a class="btn btn--ghost" href="#contact">Contactar</a>
          </div>
        </div>
      </div>
    </div>
    <span class="scroll-cue" aria-hidden="true"></span>
  </div>
</section>

<style>
  .station--hero {
    padding-block: 0;
    min-height: 150svh;
    align-items: flex-start;
  }

  .hero__stage {
    position: relative;
    width: 100%;
    min-height: 100svh;
    display: flex;
    align-items: center;
  }

  .hero__content { max-width: 40rem; }

  .hero__title {
    font-size: clamp(2.8rem, 7.5vw, 6.2rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    font-weight: 700;
    margin: 1.1rem 0 1.4rem;
    background: linear-gradient(180deg, #ffffff 30%, #b8c6ee);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-wrap: balance;
  }

  .hero__tagline {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 32rem;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.1rem;
    margin-top: 2.2rem;
  }

  .hero__links {
    display: flex;
    gap: 0.6rem;
  }

  /* --- Launch: the one call to action ------------------------------------
     A dark capsule whose border is a comet of star-coloured light circling
     it, with a glowing "ignition" core for the icon. */
  @property --launch-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  .launch {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.5rem 1.6rem 0.5rem 0.5rem;
    border: 1.5px solid transparent;
    border-radius: 999px;
    background:
      linear-gradient(135deg, rgba(20, 16, 30, 0.96), rgba(8, 10, 24, 0.96)) padding-box,
      conic-gradient(from var(--launch-angle),
        rgba(255, 255, 255, 0.14) 0deg,
        rgba(255, 255, 255, 0.14) 200deg,
        #ff8a3d 260deg,
        #fff1d6 310deg,
        #7fd8ff 340deg,
        rgba(255, 255, 255, 0.14) 360deg) border-box;
    color: #fff;
    font: inherit;
    text-align: left;
    cursor: pointer;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45), 0 0 44px rgba(255, 138, 61, 0.22);
    animation: launch-orbit 3.6s linear infinite;
    transition: transform 0.45s var(--ease-out), box-shadow 0.45s ease;
  }

  @keyframes launch-orbit {
    to { --launch-angle: 360deg; }
  }

  .launch:hover,
  .launch:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 16px 50px rgba(0, 0, 0, 0.5), 0 0 64px rgba(255, 138, 61, 0.4);
    animation-duration: 1.6s;
  }

  .launch:active { transform: translateY(0) scale(0.98); }

  .launch__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    flex: none;
    border-radius: 50%;
    color: #2a1204;
    background: radial-gradient(circle at 35% 30%, #fffaf0, #ffd08a 45%, #ff8a3d 100%);
    box-shadow: 0 0 22px rgba(255, 170, 90, 0.75), inset 0 -3px 8px rgba(160, 60, 0, 0.35);
    transition: transform 0.45s var(--ease-out);
  }

  .launch__icon svg { margin-left: 2px; }

  /* Ignition pulse around the core. */
  .launch__icon::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgba(255, 190, 120, 0.8);
    animation: launch-ping 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  @keyframes launch-ping {
    0% { transform: scale(1); opacity: 0.9; }
    100% { transform: scale(1.9); opacity: 0; }
  }

  .launch:hover .launch__icon { transform: scale(1.08); }

  .launch__text {
    display: grid;
    gap: 0.1rem;
  }

  .launch__label {
    font-size: 1.02rem;
    font-weight: 650;
    letter-spacing: 0.01em;
  }

  .launch__hint {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 214, 170, 0.7);
  }

  /* Decorative scroll hint, desktop only (never shares space with buttons). */
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.6rem;
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, transparent, var(--ink-2));
    transform-origin: top;
    animation: cue 2.4s ease-in-out infinite;
  }

  @keyframes cue {
    0% { transform: scaleY(0); opacity: 0; }
    40% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1) translateY(16px); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .launch,
    .launch__icon::after,
    .scroll-cue { animation: none; }
  }

  /* Phones, tablets in portrait and short landscape screens: copy anchors to
     the bottom (the star is framed above it) and type scales with the space
     that is actually available. */
  @media (max-width: 900px), (max-height: 560px) {
    .hero__stage {
      flex-direction: column;
      justify-content: flex-end;
      align-items: stretch;
      padding-top: calc(var(--header-h) + 1rem);
      padding-bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
    }

    .station__inner { width: min(1200px, 100% - 2 * var(--gutter)); }

    .hero__title {
      font-size: clamp(2.2rem, min(11vw, 9svh), 4.4rem);
      margin: 0.8rem 0 0.9rem;
    }

    .hero__tagline { font-size: clamp(0.95rem, 2.4svh, 1.15rem); }
    .hero__actions { margin-top: 1.2rem; gap: 0.6rem; }
    .hero__actions .btn { padding: 0.7rem 1.15rem; font-size: 0.88rem; }

    .scroll-cue { display: none; }
  }

  /* Phones: the launch capsule spans the width, secondary links share a row. */
  @media (max-width: 560px) {
    .hero__actions { flex-direction: column; flex-wrap: nowrap; align-items: stretch; }
    .launch { justify-content: center; padding-right: 1.8rem; }
    .hero__links > .btn { flex: 1; }
  }

  @media (max-width: 380px) {
    .eyebrow { font-size: 0.6rem; letter-spacing: 0.14em; }
  }
</style>
