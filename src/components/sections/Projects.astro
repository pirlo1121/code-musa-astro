---
import type { ProjectView } from '../../lib/data';

interface Props { projects: ProjectView[] }
const { projects } = Astro.props;
const shot = (p: ProjectView) => p.shot ?? '/assets/project-placeholder.svg';
---

<section id="projects" class="station station--grid" aria-labelledby="projects-title">
  <div class="station__inner">
    <header class="section-head" data-reveal>
      <p class="kicker" data-reveal-item>04 — Nebulosa carmesí</p>
      <h2 id="projects-title" class="section-title" data-reveal-item data-focus-target>Proyectos</h2>
      <p class="section-lede" data-reveal-item>
        Todo lo que he construido. Elige uno para ver los detalles.
      </p>
    </header>

    {projects.length === 0 ? (
      <p class="glass">No hay proyectos disponibles en este momento.</p>
    ) : (
      <ul class="project-grid" role="list" data-reveal>
        {projects.map((p) => (
          <li data-reveal-item>
            <button
              type="button"
              class="project-tile glass"
              data-project-open={p._id}
              aria-haspopup="dialog"
              aria-controls={`project-dialog-${p._id}`}
            >
              <img class="project-tile__shot" src={shot(p)} alt="" width="960" height="540" loading="lazy" decoding="async" />
              <span class="project-tile__body">
                <span class="project-tile__name">{p.name}</span>
                {p.stack.length > 0 && <span class="project-tile__stack">{p.stack.slice(0, 3).join(' · ')}</span>}
              </span>
              <span class="project-tile__more" aria-hidden="true">Ver detalles →</span>
            </button>

            <dialog class="project-dialog glass" id={`project-dialog-${p._id}`} aria-labelledby={`project-${p._id}`} data-lenis-prevent>
              <button type="button" class="project-dialog__close" data-project-close aria-label="Cerrar">
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
              </button>
              <img class="project-dialog__shot" src={shot(p)} alt={`Captura de ${p.name}`} width="960" height="540" loading="lazy" decoding="async" />
              <h3 id={`project-${p._id}`} class="project-dialog__title">{p.name}</h3>
              <p class="project-dialog__text">{p.description}</p>
              {p.stack.length > 0 && (
                <ul class="chips" role="list" aria-label="Tecnologías">
                  {p.stack.map((t) => <li class="chip">{t}</li>)}
                </ul>
              )}
              <div class="project-dialog__actions">
                {p.repository && (
                  <a class="btn btn--ghost btn--sm" href={p.repository} target="_blank" rel="noopener noreferrer">
                    <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.19.7.8.58A12 12 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
                    Código
                  </a>
                )}
                {p.deploy && (
                  <a class="btn btn--primary btn--sm" href={p.deploy} target="_blank" rel="noopener noreferrer">
                    Ver en vivo
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
                  </a>
                )}
              </div>
            </dialog>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .project-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1rem;
  }

  .project-tile {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0.75rem;
    border-radius: 18px;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: transform 0.4s var(--ease-out), border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .project-tile:hover,
  .project-tile:focus-visible {
    transform: translateY(-4px);
    border-color: rgba(255, 150, 110, 0.45);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45), 0 0 40px rgba(255, 110, 70, 0.18);
  }

  .project-tile__shot {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid var(--line);
  }

  .project-tile__body {
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem 0.4rem 0.3rem;
  }

  .project-tile__name {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .project-tile__stack {
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .project-tile__more {
    margin-top: auto;
    padding: 0.5rem 0.4rem 0.2rem;
    font-size: 0.8rem;
    color: var(--warm);
  }

  /* Detail -------------------------------------------------------------- */

  .project-dialog {
    position: fixed;
    inset: 0;
    width: min(40rem, 100% - 2rem);
    max-height: min(90svh, 100% - 2rem);
    margin: auto;
    overflow-y: auto;
    overscroll-behavior: contain;
    color: var(--ink);
    background: var(--glass-strong);
  }

  .project-dialog::backdrop {
    background: rgba(2, 3, 10, 0.72);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .project-dialog[open] { animation: dialog-in 0.45s var(--ease-out); }

  @keyframes dialog-in {
    from { opacity: 0; transform: translateY(24px) scale(0.97); }
  }

  .project-dialog__close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: rgba(2, 3, 10, 0.7);
    color: var(--ink);
    cursor: pointer;
  }

  .project-dialog__shot {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid var(--line);
  }

  .project-dialog__title {
    margin-top: 1.25rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .project-dialog__text {
    margin-top: 0.75rem;
    color: var(--ink-2);
    line-height: 1.7;
  }

  .project-dialog__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-project-open]').forEach((button) => {
    const dialog = document.getElementById(`project-dialog-${button.dataset.projectOpen}`) as HTMLDialogElement | null;
    if (!dialog) return;

    button.addEventListener('click', () => {
      dialog.showModal();
      window.dispatchEvent(new CustomEvent('space:lock'));
    });

    // Esc, the close button and a click on the backdrop all close it; focus
    // returns to the tile automatically.
    dialog.addEventListener('close', () => window.dispatchEvent(new CustomEvent('space:unlock')));
    dialog.querySelector('[data-project-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target !== dialog) return;
      const r = dialog.getBoundingClientRect();
      const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if (!inside) dialog.close();
    });
  });
</script>
