---
import type { ProjectView } from '../../lib/data';
import ProjectCard from './ProjectCard.astro';

interface Props { projects: ProjectView[] }
const { projects } = Astro.props;

// Newest first: MongoDB ids start with their creation timestamp, so they sort
// chronologically as plain strings.
const sorted = [...projects].sort((a, b) => b._id.localeCompare(a._id));
const latest = sorted.slice(0, 3);
const rest = sorted.slice(3);
---

<section id="projects" class="station station--grid" aria-labelledby="projects-title">
  <div class="station__inner">
    <header class="section-head" data-reveal>
      <p class="kicker" data-reveal-item>04 — Nebulosa carmesí</p>
      <h2 id="projects-title" class="section-title" data-reveal-item data-focus-target>Proyectos</h2>
    </header>

    {projects.length === 0 ? (
      <p class="glass">No hay proyectos disponibles en este momento.</p>
    ) : (
      <>
        <ul class="project-grid" role="list" data-reveal>
          {latest.map((p) => <li data-reveal-item><ProjectCard project={p} /></li>)}
        </ul>

        {rest.length > 0 && (
          <>
            <ul class="project-grid project-grid--more" id="projects-more" role="list" hidden>
              {rest.map((p) => <li><ProjectCard project={p} /></li>)}
            </ul>
            <div class="projects-toggle" data-reveal>
              <button type="button" class="btn btn--ghost" id="projects-toggle" aria-expanded="false" aria-controls="projects-more" data-reveal-item>
                <span class="projects-toggle__label">Ver todos los proyectos ({projects.length})</span>
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </button>
            </div>
          </>
        )}
      </>
    )}
  </div>
</section>

<style>
  .project-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1.1rem;
  }

  .project-grid--more { margin-top: 1.1rem; }
  .project-grid--more[hidden] { display: none; }

  .projects-toggle {
    display: flex;
    justify-content: center;
    margin-top: 2.2rem;
  }

  .projects-toggle svg { transition: transform 0.5s var(--ease-out); }
  #projects-toggle[aria-expanded='true'] svg { transform: rotate(180deg); }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { frame } from '../../lib/store';

  const PROJECTS_STATION = 3;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // --- Detail dialogs --------------------------------------------------------
  document.querySelectorAll<HTMLButtonElement>('[data-project-open]').forEach((button) => {
    const dialog = document.getElementById(`project-dialog-${button.dataset.projectOpen}`) as HTMLDialogElement | null;
    if (!dialog) return;

    button.addEventListener('click', () => {
      dialog.showModal();
      window.dispatchEvent(new CustomEvent('space:lock'));
    });

    // Esc, the close button and a click on the backdrop all close it; focus
    // returns to the tile automatically.
    dialog.addEventListener('close', () => window.dispatchEvent(new CustomEvent('space:unlock')));
    dialog.querySelector('[data-project-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target !== dialog) return;
      const r = dialog.getBoundingClientRect();
      const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if (!inside) dialog.close();
    });
  });

  // --- "Ver todos": the nebula opens up to reveal every project ---------------
  const toggle = document.getElementById('projects-toggle');
  const more = document.getElementById('projects-more');
  const label = toggle?.querySelector('.projects-toggle__label');

  toggle?.addEventListener('click', () => {
    if (!more || !label) return;
    const expand = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(expand));
    label.textContent = expand ? 'Ver menos' : `Ver todos los proyectos (${document.querySelectorAll('[data-project-open]').length})`;
    frame.expandedStation = expand ? PROJECTS_STATION : -1;

    if (expand) {
      more.hidden = false;
      if (!reducedMotion) {
        gsap.from(more.children, {
          autoAlpha: 0, y: 40, scale: 0.94, duration: 0.9, ease: 'expo.out', stagger: 0.07, clearProps: 'all',
        });
      }
    } else {
      more.hidden = true;
      // Keep the button where the eye is, instead of letting the page jump.
      toggle.scrollIntoView({ block: 'center', behavior: 'auto' });
    }
    // Section height changed: re-measure the journey.
    requestAnimationFrame(() => ScrollTrigger.refresh());
  });
</script>
