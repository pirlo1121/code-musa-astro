---
import type { Profile } from '../lib/data';
import { site } from '../data/site';

interface Props { profile: Profile | null }
const { profile } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p>© {year} {profile?.name ?? site.fallbackName}. Fin de la transmisión.</p>
    <a class="link-arrow" href="#hero">Volver al inicio</a>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    padding: 2.5rem 0 calc(2.5rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--line);
    background: linear-gradient(to top, rgba(2, 3, 10, 0.95), rgba(2, 3, 10, 0.6));
    color: var(--ink-3);
    font-size: 0.85rem;
  }

  .site-footer__inner {
    width: min(1200px, 100% - 2 * var(--gutter));
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
  }
</style>
