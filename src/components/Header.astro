---
import { SECTIONS } from '../data/site';
---

<a class="skip-link" href="#main">Saltar al contenido</a>

<header class="site-header" id="site-header">
  <div class="site-header__bar">
    <a class="brand" href="#hero" aria-label="Inicio">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
      </span>
      <span class="brand__name">Dev Code</span>
    </a>

    <nav class="site-nav" aria-label="Secciones">
      <ol>
        {SECTIONS.map((s, i) => (
          <li>
            <a href={`#${s.id}`} data-nav={i}>
              <span class="site-nav__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {s.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <label class="quality">
      <span class="visually-hidden">Calidad visual de la experiencia 3D</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/><circle cx="12" cy="12" r="3"/></svg>
      <select id="quality-select">
        <option value="auto">Auto</option>
        <option value="high">Alta</option>
        <option value="medium">Media</option>
        <option value="low">Ligera</option>
        <option value="off">Sin 3D</option>
      </select>
    </label>
  </div>
  <div class="site-header__progress" aria-hidden="true"><span id="journey-progress"></span></div>
</header>

<!-- Cinematic readout. Decorative: the real navigation is the header nav. -->
<div class="hud" aria-hidden="true">
  <span class="hud__index" id="hud-index">01 / 06</span>
  <span class="hud__line"></span>
  <span class="hud__object" id="hud-object">{SECTIONS[0].object}</span>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<style is:global>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--space);
    font-weight: 600;
    transform: translateY(-200%);
    transition: transform 0.2s ease;
  }
  .skip-link:focus { transform: none; }

  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    padding-top: env(safe-area-inset-top, 0px);
    background: linear-gradient(to bottom, rgba(2, 3, 10, 0.85), rgba(2, 3, 10, 0));
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: min(1280px, 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding-block: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.01em;
    flex-shrink: 0;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    color: var(--space);
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    box-shadow: 0 0 24px rgba(127, 216, 255, 0.35);
  }

  .site-nav { margin-inline: auto; min-width: 0; }

  .site-nav ol {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0.3rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(8, 11, 24, 0.55);
  }

  .site-nav a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s ease, background-color 0.25s ease;
  }

  .site-nav__index {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-3);
    transition: color 0.25s ease;
  }

  .site-nav a:hover { color: var(--ink); }

  .site-nav a[aria-current='true'] {
    color: var(--space);
    background: var(--ink);
  }
  .site-nav a[aria-current='true'] .site-nav__index { color: var(--space); opacity: 0.6; }

  .quality {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.4rem 0.35rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-2);
    background: rgba(8, 11, 24, 0.55);
    flex-shrink: 0;
  }

  .quality select {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.8rem;
    padding: 0.15rem 0.4rem;
    cursor: pointer;
  }
  .quality select option { background: #0b0f1e; color: var(--ink); }
  .quality:focus-within { border-color: var(--accent); }

  .site-header__progress {
    height: 1px;
    background: var(--line);
  }
  .site-header__progress span {
    display: block;
    height: 100%;
    width: 100%;
    transform-origin: left;
    transform: scaleX(0);
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    box-shadow: 0 0 12px var(--accent);
  }

  .hud {
    position: fixed;
    left: var(--gutter);
    bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
    pointer-events: none;
  }
  .hud__index { color: var(--ink); }
  .hud__line { width: 48px; height: 1px; background: currentColor; opacity: 0.6; }

  .toast {
    position: fixed;
    right: var(--gutter);
    bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
    z-index: 60;
    max-width: 22rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(8, 11, 24, 0.9);
    color: var(--ink-2);
    font-size: 0.8rem;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }
  .toast.is-visible { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    .site-header__bar { flex-wrap: wrap; gap: 0.6rem 1rem; padding-block: 0.7rem 0.5rem; }
    .site-nav { order: 3; width: 100%; margin: 0; }
    .site-nav ol {
      overflow-x: auto;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
    }
    .site-nav ol::-webkit-scrollbar { display: none; }
    .site-nav li { scroll-snap-align: start; }
    .quality { margin-left: auto; }
    .hud { display: none; }
  }

  @media (max-height: 760px) {
    .hud { display: none; }
  }
</style>
