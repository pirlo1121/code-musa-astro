---
import '../styles/global.css';
// Self-hosted via @fontsource — no third-party font round-trips.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title       = "Maicol Bautista – Software Developer",
  description = "Portfolio de Maicol Bautista, desarrollador de software especializado en JavaScript, Node.js, Express, MongoDB y AWS. Un viaje por el espacio a través de sus proyectos y habilidades.",
  ogImage     = "/assets/og-image.jpg",
} = Astro.props;

const siteURL   = "https://code-musa.com";
const canonical = siteURL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#02030a">
    <meta name="color-scheme" content="dark">

    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="author" content="Maicol Bautista">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href={canonical}>

    <meta property="og:type"        content="website">
    <meta property="og:url"         content={canonical}>
    <meta property="og:title"       content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image"       content={`${siteURL}${ogImage}`}>
    <meta property="og:locale"      content="es_CO">

    <meta name="twitter:card"        content="summary_large_image">
    <meta name="twitter:title"       content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image"       content={`${siteURL}${ogImage}`}>

    <link rel="icon" type="image/svg+xml" href="/fav.svg">

    <link rel="dns-prefetch" href="https://api.code-musa.com">
    <link rel="preconnect" href="https://api.code-musa.com" crossorigin>
    <link rel="sitemap" href="/sitemap.xml">

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Maicol Bautista",
        "url": "https://code-musa.com",
        "jobTitle": "Software Developer",
        "knowsAbout": ["JavaScript", "TypeScript", "Node.js", "Express", "MongoDB", "AWS", "Linux", "Git"],
        "image": "https://code-musa.com/assets/profile.jpg",
        "sameAs": []
      }
    </script>

    <!-- Blocking, before first paint: settle the layout mode for visitors who
         will not get the 3D journey, so the page does not reflow once JS runs.
         is:inline keeps it a classic blocking script. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var pref = localStorage.getItem('space-quality');
          var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (pref === 'off' || ((!pref || pref === 'auto') && reduced)) d.dataset.quality = 'off';
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
