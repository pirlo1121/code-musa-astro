---
import '../styles/global.css';
// Self-hosted via @fontsource — no external font round-trips. latin-only
// subset and only the weights the CSS uses.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title       = "Maicol Bautista – Software Developer",
  description = "Portfolio de Maicol Bautista, desarrollador de software: un viaje por el universo a través de sus proyectos, stack y trayectoria.",
  ogImage     = "/assets/og-image.jpg",
} = Astro.props;

const siteURL   = "https://code-musa.com";
const canonical = siteURL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#02030a">
    <meta name="color-scheme" content="dark">

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="author" content="Maicol Bautista">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href={canonical}>

    <!-- Open Graph -->
    <meta property="og:type"        content="website">
    <meta property="og:url"         content={canonical}>
    <meta property="og:title"       content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image"       content={`${siteURL}${ogImage}`}>
    <meta property="og:locale"      content="es_CO">

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image">
    <meta name="twitter:title"       content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image"       content={`${siteURL}${ogImage}`}>

    <link rel="icon" type="image/svg+xml" href="/fav.svg">

    <link rel="dns-prefetch" href="https://api.code-musa.com">
    <link rel="preconnect" href="https://api.code-musa.com" crossorigin>

    <link rel="sitemap" href="/sitemap.xml">

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Maicol Bautista",
        "url": "https://code-musa.com",
        "jobTitle": "Software Developer",
        "knowsAbout": ["JavaScript", "Node.js", "Express", "MongoDB", "AWS", "Linux", "Git"],
        "image": "https://code-musa.com/assets/profile.jpg",
        "sameAs": []
      }
    </script>

    <!-- Progressive enhancement: the cinematic journey (fixed panels over a
         WebGL universe) only switches on when WebGL2 exists. Without it — or
         without JS — the same content renders as a normal scrolling page.
         Blocking + inline so the layout is decided before first paint. -->
    <script is:inline>
      (function () {
        try {
          if (/[?&]flat\b/.test(location.search)) return;
          var c = document.createElement('canvas');
          var gl = c.getContext('webgl2');
          if (!gl) return;
          var lose = gl.getExtension('WEBGL_lose_context');
          if (lose) lose.loseContext();
          document.documentElement.classList.add('journey');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
