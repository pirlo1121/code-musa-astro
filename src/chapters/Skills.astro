---
import Chapter from './Chapter.astro';
import Panel from './Panel.astro';
import type { Stop } from '../data/journey';
import { skills } from '../data/skills';

interface Props {
  stops: Stop[];
}

const { stops } = Astro.props;
const [intro, ...planets] = stops;
const total = String(skills.length).padStart(2, '0');
---

<Chapter id="skills" stops={stops} label="Habilidades">
  <Panel stop={intro} label="Stack">
    <p class="kicker" data-anim>Sistema solar · Stack</p>
    <h2 data-anim>Habilidades</h2>
    <p class="muted" data-anim>
      Cada planeta es una tecnología con la que trabajo. Acércate a uno para ver los detalles.
    </p>
    <ul class="chips" data-anim>
      {skills.map((s, i) => (
        <li>
          <button type="button" class="chip" style={`--accent: ${s.accent}`} data-goto-stop={planets[i].index}>
            <i></i>{s.name}
          </button>
        </li>
      ))}
    </ul>
  </Panel>

  {skills.map((s, i) => (
    <Panel stop={planets[i]} label={s.name}>
      <div class="skill" style={`--accent: ${s.accent}`}>
        <p class="kicker" data-anim>Planeta {String(i + 1).padStart(2, '0')} / {total}</p>
        <h3 class="skill__name" data-anim><i></i>{s.name}</h3>
        <p data-anim>{s.summary}</p>
        <ul class="tags" data-anim>
          {s.uses.map((u) => <li>{u}</li>)}
        </ul>
      </div>
    </Panel>
  ))}
</Chapter>
