---
import Chapter from './Chapter.astro';
import Panel from './Panel.astro';
import type { Stop } from '../data/journey';
import type { Profile } from '../lib/data';
import { API_BASE_URL } from '../config';

interface Props {
  stops: Stop[];
  profile: Profile | null;
}

const { stops, profile } = Astro.props;
const year = new Date().getFullYear();
---

<Chapter id="contact" stops={stops} label="Contacto">
  <Panel stop={stops[0]} label="Contacto" variant="holo">
    <p class="kicker" data-anim>Estación Musa · Canal abierto</p>
    <h2 data-anim>Contacto</h2>
    <p class="muted" data-anim>¿Tienes un proyecto en mente? Envía una señal.</p>

    <form id="contact-form" class="form" data-anim>
      <label>
        <span>Nombre</span>
        <input type="text" name="name" required autocomplete="name" placeholder="Tu nombre" />
      </label>
      <label>
        <span>Email</span>
        <input type="email" name="email" required autocomplete="email" placeholder="tu@email.com" />
      </label>
      <label>
        <span>Mensaje</span>
        <textarea name="message" required rows="4" placeholder="¿En qué puedo ayudarte?"></textarea>
      </label>
      <button type="submit" class="btn btn--primary">Transmitir mensaje</button>
      <p class="form__status" role="status" aria-live="polite"></p>
    </form>

    <footer class="contact__footer" data-anim>
      <span>© {year} Maicol Bautista</span>
      {profile?.socialLinks?.github && (
        <a href={profile.socialLinks.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      )}
      {profile?.socialLinks?.linkedin && (
        <a href={profile.socialLinks.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      )}
    </footer>
  </Panel>
</Chapter>

<script is:inline define:vars={{ API_BASE_URL }}>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = form.querySelector('button');
    const status = form.querySelector('.form__status');
    const data = Object.fromEntries(new FormData(form));
    if (!data.name || !data.email || !data.message) return;

    button.disabled = true;
    button.textContent = 'Transmitiendo…';
    status.className = 'form__status';
    status.textContent = '';

    try {
      const res = await fetch(`${API_BASE_URL}/contact`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const body = await res.json();
      if (body.ok) {
        status.textContent = body.msg || 'Señal recibida. Te responderé pronto.';
        status.classList.add('is-ok');
        form.reset();
      } else {
        status.textContent = body.msg || 'No se pudo enviar el mensaje.';
        status.classList.add('is-error');
      }
    } catch (err) {
      console.error(err);
      status.textContent = 'Se perdió la señal. Inténtalo de nuevo.';
      status.classList.add('is-error');
    }

    button.disabled = false;
    button.textContent = 'Transmitir mensaje';
  });
</script>
