---
// A chapter is a scroll spacer that owns a contiguous run of stops. In journey
// mode its height (set by the runtime) is the scroll distance of those stops
// and its panels are fixed overlays; in flat mode it is a normal section.
import type { ChapterId, Stop } from '../data/journey';

interface Props {
  id: ChapterId;
  stops: Stop[];
  label: string;
}

const { id, stops, label } = Astro.props;
const first = stops[0].index;
const last = stops[stops.length - 1].index;
const slots = stops.reduce((sum, s) => sum + s.slot, 0);
---

<section
  id={id}
  class={`chapter chapter--${id}`}
  data-chapter={id}
  data-first={first}
  data-last={last}
  aria-label={label}
  style={`--slots: ${slots}`}
>
  <slot />
</section>
