---
import { Image } from 'astro:assets';
import Chapter from './Chapter.astro';
import Panel from './Panel.astro';
import type { Stop } from '../data/journey';
import type { Project } from '../lib/data';

interface Props {
  stops: Stop[];
  projects: Project[];
}

const { stops, projects } = Astro.props;
const total = String(projects.length).padStart(2, '0');
---

<Chapter id="projects" stops={stops} label="Proyectos">
  {projects.length === 0 ? (
    <Panel stop={stops[0]} label="Proyectos">
      <p class="kicker" data-anim>Cúmulo de galaxias · Proyectos</p>
      <h2 data-anim>Proyectos</h2>
      <p class="muted" data-anim>Las galaxias se están formando. Vuelve pronto.</p>
    </Panel>
  ) : (
    projects.map((p, i) => (
      <Panel stop={stops[i]} label={p.name}>
        <article class="project">
          <p class="kicker" data-anim>Galaxia {String(i + 1).padStart(2, '0')} / {total} · Proyectos</p>
          <h3 class="project__name" data-anim>{p.name}</h3>
          <div class="project__media" data-anim>
            {p.image ? (
              <Image src={p.image} alt={`Captura de ${p.name}`} width={640} height={360} loading="lazy" decoding="async" />
            ) : (
              <img src="/assets/project-placeholder.svg" alt="" width="640" height="360" loading="lazy" decoding="async" />
            )}
          </div>
          <p class="project__desc" data-anim>{p.description}</p>
          <ul class="tags" data-anim>
            {p.stack.map((s) => <li>{s}</li>)}
          </ul>
          <div class="links" data-anim>
            {p.repository && <a href={p.repository} target="_blank" rel="noopener noreferrer">Código ↗</a>}
            {p.deploy && <a href={p.deploy} target="_blank" rel="noopener noreferrer">Ver en vivo ↗</a>}
          </div>
        </article>
      </Panel>
    ))
  )}
</Chapter>
