---
import Chapter from './Chapter.astro';
import Panel from './Panel.astro';
import type { Stop } from '../data/journey';
import type { Profile } from '../lib/data';

interface Props {
  stops: Stop[];
  profile: Profile | null;
}

const { stops, profile } = Astro.props;
const name = profile?.name ?? 'Maicol Bautista';
const profession = profile?.profession ?? 'Software Developer';
---

<Chapter id="hero" stops={stops} label="Inicio">
  <Panel stop={stops[0]} label="Inicio" variant="bare">
    <p class="kicker" data-anim>// Transmisión entrante · Estación Musa</p>
    <h1 class="hero__name" data-anim>{name}</h1>
    <p class="hero__role" data-anim>{profession}</p>
    <p class="hero__claim" data-anim>
      Diseño y construyo software que escala: del servidor a la última estrella.
    </p>
    <div class="hero__actions" data-anim>
      <a class="btn btn--primary" href="#about" data-goto="about">Iniciar viaje</a>
      <a class="btn btn--ghost" href="#contact" data-goto="contact">Contactar</a>
    </div>
  </Panel>
  <div class="scroll-hint" data-scroll-hint aria-hidden="true">
    <span>Desliza para navegar</span>
    <i></i>
  </div>
</Chapter>
