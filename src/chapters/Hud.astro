---
import { NAV_CHAPTERS } from '../data/journey';
---

<header class="hud">
  <a class="hud__brand" href="#hero" data-goto="hero" aria-label="Inicio">
    <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
      <polyline points="2 17 12 22 22 17"></polyline>
      <polyline points="2 12 12 17 22 12"></polyline>
    </svg>
    <span>Dev Code</span>
  </a>

  <nav class="hud__nav" aria-label="Capítulos">
    <ul>
      {NAV_CHAPTERS.map((c, i) => (
        <li>
          <a href={`#${c.id}`} data-goto={c.id}>
            <span class="hud__index">0{i + 1}</span>{c.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <span class="hud__chapter" data-hud-chapter aria-hidden="true"></span>

  <div class="hud__progress" aria-hidden="true"><span data-hud-progress></span></div>
</header>
