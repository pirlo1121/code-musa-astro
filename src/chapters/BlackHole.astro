---
import Chapter from './Chapter.astro';
import Panel from './Panel.astro';
import type { Stop } from '../data/journey';

interface Props {
  stops: Stop[];
}

const { stops } = Astro.props;
---

<Chapter id="blackhole" stops={stops} label="Horizonte de eventos">
  <Panel stop={stops[0]} label="Horizonte" side="center" variant="bare">
    <p class="kicker" data-anim>Horizonte de eventos</p>
    <p class="quote" data-anim>
      Todo proyecto cruza su propio horizonte de eventos.<br />
      Lo que sale del otro lado es experiencia.
    </p>
  </Panel>
</Chapter>
