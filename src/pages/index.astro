---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hud from '../chapters/Hud.astro';
import Hero from '../chapters/Hero.astro';
import About from '../chapters/About.astro';
import Skills from '../chapters/Skills.astro';
import Projects from '../chapters/Projects.astro';
import BlackHole from '../chapters/BlackHole.astro';
import Experience from '../chapters/Experience.astro';
import Contact from '../chapters/Contact.astro';
import Universe from '../universe/Universe';
import { getProfile, getProjects } from '../lib/data';
import { buildStops, type ChapterId } from '../data/journey';
import { skills } from '../data/skills';
import { experience } from '../data/experience';

const [profile, projects] = await Promise.all([getProfile(), getProjects()]);

const counts = { skills: skills.length, projects: projects.length, experience: experience.length };
const stops = buildStops(counts);
const of = (id: ChapterId) => stops.filter((s) => s.chapter === id);

// The island only needs what shapes the scene, never the full payload
const galaxies = projects.map((p) => ({ id: p._id, name: p.name }));
---

<BaseLayout>
  <div class="universe" aria-hidden="true">
    <Universe client:only="react" counts={counts} galaxies={galaxies} />
  </div>

  <Hud />

  <main class="journey-track">
    <Hero stops={of('hero')} profile={profile} />
    <About stops={of('about')} profile={profile} />
    <Skills stops={of('skills')} />
    <Projects stops={of('projects')} projects={projects} />
    <BlackHole stops={of('blackhole')} />
    <Experience stops={of('experience')} />
    <Contact stops={of('contact')} profile={profile} />
  </main>
</BaseLayout>

<script>
  import { initJourney } from '../scroll/runtime';
  initJourney();
</script>
