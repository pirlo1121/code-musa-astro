---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SpaceBackdrop from '../components/ui/SpaceBackdrop.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Skills from '../components/sections/Skills.astro';
import Projects from '../components/sections/Projects.astro';
import Experience from '../components/sections/Experience.astro';
import Contact from '../components/sections/Contact.astro';
import { getProfile, getProjects, type ProjectView } from '../lib/data';
import type { ProjectBody } from '../scenes/types';

const [profile, projects] = await Promise.all([getProfile(), getProjects()]);

// Screenshots are resized and re-encoded at build time (16:9 WebP), then
// served same-origin: the 3D hologram can use them as textures without CORS.
const projectViews: ProjectView[] = await Promise.all(projects.map(async (p) => {
  if (!p.image) return { ...p, shot: null };
  try {
    const img = await getImage({ src: p.image, width: 960, height: 540, format: 'webp', quality: 78 });
    return { ...p, shot: img.src };
  } catch (err) {
    console.error('[build] Failed to optimise screenshot for', p.name, err);
    return { ...p, shot: null };
  }
}));

const bodies: ProjectBody[] = projectViews.map((p) => ({ id: p._id, name: p.name, image: p.shot }));
---

<BaseLayout>
  <SpaceBackdrop projects={bodies} />
  <Header />

  <main id="main" class="journey">
    <Hero profile={profile} />
    <About profile={profile} />
    <Skills />
    <Projects projects={projectViews} />
    <Experience />
    <Contact profile={profile} />
  </main>

  <Footer profile={profile} />
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initScrollDirector } from '../animations/scroll-director';
  import { getQuality, setQualityPref, subscribeQuality, effectiveTier, type QualityPref } from '../lib/store';
  import { SECTIONS } from '../data/site';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // --- HUD + nav state ------------------------------------------------------
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
  const hudIndex = document.getElementById('hud-index');
  const hudObject = document.getElementById('hud-object');
  const progress = document.getElementById('journey-progress');
  const pad = (n: number) => String(n).padStart(2, '0');

  initScrollDirector({
    reducedMotion,
    onSection(i) {
      navLinks.forEach((a) => {
        if (Number(a.dataset.nav) === i) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
      // Keep the active pill visible in the horizontally scrollable mobile nav.
      const link = navLinks[i];
      const list = link?.closest('ol');
      if (link && list && list.scrollWidth > list.clientWidth) {
        list.scrollTo({ left: link.offsetLeft - 16, behavior: reducedMotion ? 'auto' : 'smooth' });
      }
      if (hudIndex) hudIndex.textContent = `${pad(i + 1)} / ${pad(SECTIONS.length)}`;
      if (hudObject) hudObject.textContent = SECTIONS[i].object;
    },
    onProgress(p) {
      if (progress) progress.style.transform = `scaleX(${p})`;
    },
  });

  // --- Intro ----------------------------------------------------------------
  if (!reducedMotion) {
    gsap.from('[data-intro]', { autoAlpha: 0, y: 28, duration: 1.4, ease: 'expo.out', stagger: 0.12, delay: 0.25 });
  }

  // --- Quality selector -------------------------------------------------------
  const select = document.getElementById('quality-select') as HTMLSelectElement | null;
  const toast = document.getElementById('toast');
  let toastTimer = 0;

  function showToast(text: string) {
    if (!toast) return;
    toast.textContent = text;
    toast.classList.add('is-visible');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 4500);
  }

  if (select) {
    select.value = getQuality().pref;
    select.addEventListener('change', () => setQualityPref(select.value as QualityPref));
  }

  let lastTier = effectiveTier();
  subscribeQuality(() => {
    const tier = effectiveTier();
    if (select) select.value = getQuality().pref;
    // Section heights differ with and without the 3D journey.
    if ((tier === 'off') !== (lastTier === 'off')) requestAnimationFrame(() => ScrollTrigger.refresh());
    lastTier = tier;
  });

  window.addEventListener('space:downgrade', () => {
    const tier = effectiveTier();
    showToast(tier === 'off'
      ? 'Tu dispositivo no mantiene la fluidez: activamos el modo sin 3D. Puedes cambiarlo arriba.'
      : 'Ajustamos la calidad visual automáticamente para mantener la fluidez.');
  });
</script>
